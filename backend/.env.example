# Exemple de configuration backend KZIIK
# Copiez ce fichier en .env puis adaptez les valeurs

# Environnement
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kziik

# Serveur HTTP
PORT=3000

# Authentification
JWT_SECRET=change-moi

# Frontend autorisé (optionnel)
FRONTEND_URL=https://kziik.com

# SMTP HOSTINGER (SSL 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@kziik.com
SMTP_PASS=@SUCCESS7a
SMTP_USER_INSCRIPTION=inscription@kziik.com
SMTP_PASS_INSCRIPTION=@SUCCESS7a
SMTP_USER_NO_REPLY=no-reply@kziik.com
SMTP_PASS_NO_REPLY=@SUCCESS7a
FROM_EMAIL_INSCRIPTION=inscription@kziik.com
FROM_EMAIL_NO_REPLY=no-reply@kziik.com
