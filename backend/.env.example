# Exemple de configuration backend KZIIK
# Copiez ce fichier en .env puis adaptez les valeurs

# Environnement
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kziik

# Serveur HTTP
PORT=3000

# Authentification
JWT_SECRET=change-moi

# Frontend autorisé (optionnel)
FRONTEND_URL=https://kziik.com

# SMTP (optionnel selon vos besoins)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER_INSCRIPTION=you@example.com
SMTP_PASS_INSCRIPTION=super-secret
SMTP_USER_NO_REPLY=noreply@example.com
SMTP_PASS_NO_REPLY=another-secret
FROM_EMAIL_INSCRIPTION=you@example.com
FROM_EMAIL_NO_REPLY=noreply@example.com
