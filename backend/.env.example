# ---------------------------------------------------------------------------
# Exemple de configuration pour le backend KZIIK
# Copiez ce fichier en .env (à la racine du projet ou dans backend/.env)
# et remplissez les valeurs adaptées à votre environnement.
# ---------------------------------------------------------------------------

# Base de données
MONGO_URI=mongodb://127.0.0.1:27017/kziik

# Authentification
JWT_SECRET=change_me
PORT=3000
FRONTEND_URL=http://localhost:3001

# Emails (inscription)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER_INSCRIPTION=
SMTP_PASS_INSCRIPTION=
FROM_EMAIL_INSCRIPTION=no-reply@kziik.com

# Emails (notifications / no-reply)
SMTP_USER_NO_REPLY=
SMTP_PASS_NO_REPLY=
FROM_EMAIL_NO_REPLY=no-reply@kziik.com
